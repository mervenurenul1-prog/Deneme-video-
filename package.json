{
  "name": "deneme-video",
  "version": "1.0.0",
  "private": true,
  "description": "Fitness uygulaması için Remotion + ElevenLabs ile Instagram Reels üretimi",
  "type": "module",
  "scripts": {
    "dev": "remotion studio",
    "new": "tsx scripts/new-post.ts",
    "voiceover": "NODE_USE_ENV_PROXY=1 tsx scripts/generate-voiceover.ts",
    "render": "tsx scripts/render.ts",
    "build": "npm run voiceover && npm run render",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "@remotion/bundler": "^4.0.535",
    "@remotion/cli": "^4.0.535",
    "@remotion/fonts": "^4.0.535",
    "@remotion/renderer": "^4.0.535",
    "@remotion/three": "^4.0.535",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.535",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@elevenlabs/elevenlabs-js": "^2.72.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/webpack-env": "^1.18.8",
    "dotenv": "^18.0.7",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
